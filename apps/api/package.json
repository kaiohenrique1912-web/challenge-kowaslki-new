{
  "name": "@qa/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "db:migrate": "bun src/db/migrate.ts",
    "seed": "bun src/db/seed/index.ts",
    "recompute-scores": "bun src/db/maintenance/recompute.ts",
    "typecheck": "tsc --noEmit",
    "codegen": "bunx --bun graphql-codegen --config codegen.ts",
    "bench": "bun src/bench/search-bench.ts"
  },
  "dependencies": {
    "@elysiajs/graphql-yoga": "^1.4.1",
    "@qa/shared": "workspace:*",
    "dataloader": "^2.2.3",
    "elysia": "^1.4.30",
    "graphql": "^16.6.0",
    "graphql-yoga": "3.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.3",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-resolvers": "^6.1.0",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
